# ===================================
# PDF2BPMN 통합 환경 설정 예제
# ===================================
# API 서버와 에이전트 서버가 모두 이 파일 하나를 사용합니다.

# OpenAI 호환 API 설정
OPENAI_API_KEY=sk-your-openai-compatible-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b
OCR_BASE_URL=
OCR_MODEL=openai/gpt-4.1-mini
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
EMBEDDING_DIMENSIONS=2560

# OCR 설정
ENABLE_OCR=true
OCR_ENGINE=openai_vision || synap
OCR_ALWAYS_IF_IMAGES=true
SYNAP_OCR_BASE_URL=
SYNAP_OCR_API_KEY=
SYNAP_OCR_POLL_INTERVAL_SEC=1
SYNAP_OCR_TIMEOUT_SEC=120

# API/Agent 공통 설정
PDF2BPMN_URL=http://localhost:8001
AGENT_ORCH=pdf2bpmn
POLLING_INTERVAL=5
TASK_TIMEOUT=3600
ENABLE_AUTO_AGENT_CREATION=true

# Supabase 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# Neo4j 설정
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=1234567bpmn

# 선택 옵션
LOG_LEVEL=INFO
FORCE_SINGLE_SECTION=false
USE_LLM_PROCDEF_ENRICH=true

# 메멘토(process-gpt-memento) 연동
MEMENTO_URL=http://127.0.0.1:8005
MEMENTO_TIMEOUT_SEC=30

# 생성 프로세스 실행 검증 (process-gpt-completion 실행 엔진으로 start→end 실제 실행 + 자동개선)
# - PDF2BPMN_VALIDATION_ENABLED=false 로 끄면 생성 후 검증 단계를 건너뜀
# - COMPLETION_ENGINE_URL: process-gpt-completion API 서버 주소 (폴링 서비스도 함께 떠 있어야 함)
# - PDF2BPMN_VALIDATION_MAX_ITERS: 검증-개선 루프 최대 반복 횟수 (분기 케이스가 모두
#   통과할 때까지 반복; 기본 100)
# - PDF2BPMN_VALIDATION_CLEANUP: 검증용 테스트 인스턴스를 끝나고 DB 에서 삭제할지 여부.
#   기본 false = 보존(검증이 실제 엔진으로 탄 흐름을 todolist/bpm_proc_inst 에서 확인 가능).
#   검증 흐름 상세 리포트는 output/validation/validation_*.md 에 저장된다.
# - PDF2BPMN_VALIDATION_ADVANCE_TIMEOUT: 제출(/complete) 후 폴링 서비스가 다음 단계로
#   진행(다음 활동 등장 또는 프로세스 완료)할 때까지 기다리는 최대 시간(초). 마지막
#   태스크의 완료 처리가 폴링 주기상 늦어질 수 있으므로 넉넉히 둔다(기본 70초).
PDF2BPMN_VALIDATION_ENABLED=true
COMPLETION_ENGINE_URL=http://localhost:8000
PDF2BPMN_VALIDATION_MAX_ITERS=100
PDF2BPMN_VALIDATION_CLEANUP=false
PDF2BPMN_VALIDATION_ADVANCE_TIMEOUT=70

# Skill/Agent post-processing policy
# - SKILL_EXTRACTION_MIN_RATIO 0.0 + MIN_COUNT 2 → "유사 지침 2회 이상이면 스킬"
# - SKILL_CLUSTER_SIMILARITY 한국어 변주 흡수용 (낮을수록 더 많이 묶임)
# - AGENT_CREATION_REQUIRE_AUTOMATION=false → 휴먼 업무라도 동일 스킬 반복이면 에이전트 후보
SKILL_EXTRACTION_MIN_RATIO=0.0
SKILL_EXTRACTION_MIN_COUNT=2
SKILL_CLUSTER_SIMILARITY=0.55
AGENT_CREATION_MIN_TASKS_PER_SKILL_PER_LANE=2
AGENT_CREATION_REQUIRE_AUTOMATION=false

# LLM-based skill enrichment (클러스터 → 풍부한 SOP/스킬 카드)
SKILL_LLM_ENRICHMENT=true
SKILL_LLM_MODEL=
SKILL_LLM_TIMEOUT_SEC=60
SKILL_LLM_MAX_CONCURRENCY=3
